# ─── База данных ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://lkz_user:password@localhost:5432/lkz_site"

# ─── Авторизация в админке ───────────────────────────────────────────────────────
# Пароль для входа в /admin
ADMIN_PASSWORD="придумайте-надёжный-пароль"
# Случайная строка для подписи сессий (минимум 32 символа, любые)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="замените-на-случайную-строку-минимум-32-символа"
UPLOADS_DIR="/var/www/lkz-site/uploads"
UPLOADS_URL_PREFIX="/uploads"

# Telegram-бот для уведомлений о заявках (настраивается в /adpanel/settings)
# Создать бота: @BotFather -> /newbot -> получить токен
# Chat ID: написать боту, потом https://api.telegram.org/bot{TOKEN}/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Telegram-бот для мониторинга сервера (технический, не отображается в админке)
# Использует отдельный бот-токен чтобы не пересекаться с уведомлениями о заявках
MONITOR_BOT_TOKEN=""
MONITOR_CHAT_ID=""

# MAX-бот для уведомлений о заявках
# Создать бота: в приложении MAX написать @MasterBot -> создать бота -> получить токен
# User ID: user_id вашего аккаунта в MAX (можно узнать у @MasterBot)
MAX_BOT_TOKEN=""
MAX_CHAT_ID=""
